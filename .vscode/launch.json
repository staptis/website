{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Remote pnpm dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev", "--host", "0.0.0.0", "--port", "3000"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
