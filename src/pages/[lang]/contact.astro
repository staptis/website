---
import Button from "@/components/atoms/Button.astro";
import Layout from "@/components/templates/Layout.astro";
import { LANGUAGES, getLangFromPath, t } from "@/utils/i18n";

export function getStaticPaths() {
  return LANGUAGES.map((locale) => ({
    params: { lang: locale },
  }));
}

const lang = getLangFromPath(Astro.url.pathname);
---

<Layout>
  <form
    class="flex flex-col gap-4"
    method="POST"
    action={`/api/form-contact?lang=${lang}`}
  >
    <label>Name</label>
    <input name="name" class="border-1" required />
    <label>Email address</label>
    <input type="email" name="email" class="border-1" required />
    <label>Company name</label>
    <input name="companyName" class="border-1" />
    <Button type="submit">Submit</Button>
  </form>
</Layout>
