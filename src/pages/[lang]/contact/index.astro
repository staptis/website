---
import Button from "@/components/atoms/Button.astro";
import Input from "@/components/atoms/Input.astro";
import Label from "@/components/atoms/Label.astro";
import Section from "@/components/organisms/Section.astro";
import Layout from "@/components/templates/Layout.astro";
import { LANGUAGES, getLangFromPath, t } from "@/utils/i18n";
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";

export function getStaticPaths() {
  return LANGUAGES.map((locale) => ({
    params: { lang: locale },
  }));
}

const lang = getLangFromPath(Astro.url.pathname);
---

<Layout seo={{ title: t(lang, "pages.contact") + " - Staptis" }}>
  <Section first class="flex flex-col gap-2 md:flex-row">
    <h1 class="flex-1 text-2xl sm:text-3xl md:text-4xl">
      {t(lang, "contact.get_in_touch")}
    </h1>
    <form
      class="flex flex-1 flex-col gap-4"
      method="POST"
      action={`/api/form-contact?lang=${lang}`}
    >
      <Label required>{t(lang, "contact.name")}</Label>
      <Input name="name" required />
      <Label required>{t(lang, "contact.email")}</Label>
      <Input type="email" name="email" required />
      <Label>{t(lang, "contact.company_name")}</Label>
      <Input name="companyName" />

      <!-- Turnstile CAPTCHA -->
      <div
        class="cf-turnstile"
        data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
        data-theme="light"
        data-language={lang}
        data-callback="onTsOk"
        data-expired-callback="onTsOff"
        data-error-callback="onTsOff"
      >
      </div>

      <!-- Submit Button -->
      <Button id="submit" type="submit" disabled
        >{t(lang, "contact.send_message")}</Button
      >
    </form>
  </Section>
</Layout>

<script
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
  is:inline></script>
<script is:inline>
  function onTsOk() {
    document.getElementById("submit").disabled = false;
  }
  function onTsOff() {
    document.getElementById("submit").disabled = true;
  }
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector("form");
    const submitBtn = document.getElementById("submit");

    form?.addEventListener("submit", () => {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = t(lang, "contact.sending_message");
      }
    });
  });
</script>
