---
import Button from "@/components/atoms/Button.astro";
import Section from "@/components/organisms/Section.astro";
import Layout from "@/components/templates/Layout.astro";
---

<Layout seo={{ title: "500 - Staptis" }}>
  <Section
    first
    class="flex min-h-[60vh] flex-col items-center justify-center gap-6 text-center"
  >
    <h1 class="text-primary text-5xl font-bold tracking-tight">500</h1>
    <p class="max-w-prose text-xl font-medium text-gray-600">
      Oops! Something went wrong on our end.
    </p>
    <a href="/" class="inline-block">
      <Button variant="primary">Go to homepage</Button>
    </a>
  </Section>
</Layout>
