---
import { getLangFromPath, t } from "@/utils/i18n";

import Link from "@/components/ui/Link.astro";
const logo = "/logo_with_name.png";
const lang = getLangFromPath(Astro.url.pathname);
---

<header
  id="header"
  class="bg-opacity-100 fixed top-4 right-4 left-4 z-50 rounded-2xl bg-white/90 px-6 py-4 shadow-xl backdrop-blur-sm transition-all duration-500"
  role="banner"
>
  <div class="flex items-center justify-between">
    <!-- Logo -->
    <a href="" class="flex items-center space-x-3" aria-label="Homepage">
      <img src={logo} alt="Staptis logo" class="h-8 w-auto" />
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden space-x-6 font-medium text-gray-700 md:flex"
      aria-label="Main navigation"
    >
      <Link href="" label={t(lang, "navigation.home")} />
      <Link href="/about" label={t(lang, "navigation.about")} />
      <Link href="/contact" label={t(lang, "navigation.contact")} />
    </nav>

    <!-- Hamburger Menu -->
    <button
      id="menu-button"
      class="focus:outline-none md:hidden"
      aria-label="Toggle menu"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <svg
        class="h-6 w-6 text-gray-800"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-nav"
    class="mt-4 flex hidden flex-col space-y-2 md:hidden"
    aria-label="Mobile navigation"
  >
    <Link href="/" label={t(lang, "navigation.home")} />
    <Link href="/about" label={t(lang, "navigation.about")} />
    <Link href="/contact" label={t(lang, "navigation.contact")} />
  </nav>

  <!-- Plain inline script (runs on client) -->
  <script>
    if (typeof window !== "undefined") {
      const menuButton = document.getElementById("menu-button");
      const mobileNav = document.getElementById("mobile-nav");
      const header = document.getElementById("header");

      menuButton?.addEventListener("click", () => {
        const isOpen = mobileNav?.classList.toggle("hidden");
        menuButton.setAttribute("aria-expanded", (!isOpen).toString());
      });

      window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
          header?.classList.add(
            "bg-white/50",
            "backdrop-blur-none",
            "scale-[0.90]",
          );
          header?.classList.remove("bg-white/90");
        } else {
          header?.classList.add("bg-white/90");
          header?.classList.remove(
            "bg-white/50",
            "backdrop-blur-none",
            "scale-[0.90]",
          );
        }
      });
    }
  </script>
</header>
