---
// You can optionally pass props like `logoSrc` and `year`
const currentYear = new Date().getFullYear();
const logo = "/logo_with_name.png";
---
<footer class="bg-gray-900 text-white py-6">
  <div class="container mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
    <!-- Logo -->
    <div class="flex items-center gap-2">
      <img src=`${logo}` alt="Logo" class="h-8 w-auto" />
    </div>

    <!-- Links -->
    <nav class="flex flex-wrap gap-4 text-sm">
      <a href="/privacy" class="hover:underline">Privacy & Cookies</a>
      <a href="/terms-of-use" class="hover:underline">Terms of use</a>
    </nav>
  </div>

  <!-- Bottom line -->
  <div class="text-center text-xs text-gray-400 mt-6 px-4">
    © {currentYear} Staptis. All rights reserved
  </div>
</footer>
