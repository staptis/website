---
import { getLangFromPath, t } from "@/utils/i18n";
import Link from "@/components/ui/Link.astro";
// You can optionally pass props like `logoSrc` and `year`
const currentYear = new Date().getFullYear();
const logo = "/logo_with_name.png";
const lang = getLangFromPath(Astro.url.pathname);
---

<footer class="bg-gray-900 py-6 text-white">
  <div
    class="container mx-auto flex flex-col items-center justify-between gap-4 px-4 md:flex-row"
  >
    <!-- Logo -->
    <a href="" aria-label="Homepage">
      <img src={logo} alt="Staptis logo" class="h-8 w-auto" />
    </a>

    <!-- Links -->
    <nav class="flex flex-wrap gap-4 text-sm">
      <Link
        variant="simple"
        href="/privacy"
        label={t(lang, "footer.privacy_policy")}
      />
      <Link
        variant="simple"
        href="/terms-of-use"
        label={t(lang, "footer.terms_of_service")}
      />
    </nav>
  </div>

  <!-- Bottom line -->
  <div class="mt-6 px-4 text-center text-xs text-gray-400">
    <p>
      &copy; <span id="footer-year">{currentYear}</span> Staptis {
        t(lang, "footer.all_rights_reserved")
      }
    </p>
  </div>
</footer>
<script is:inline>
  document.getElementById("footer-year").innerText = new Date().getFullYear();
</script>
