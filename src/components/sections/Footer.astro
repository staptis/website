---
// You can optionally pass props like `logoSrc` and `year`
const currentYear = new Date().getFullYear();
const logo = "/logo_with_name.png";
---

<footer class="bg-gray-900 py-6 text-white">
  <div
    class="container mx-auto flex flex-col items-center justify-between gap-4 px-4 md:flex-row"
  >
    <!-- Logo -->
    <div class="flex items-center gap-2">
      <img src={logo} alt="Logo" class="h-8 w-auto" />
    </div>

    <!-- Links -->
    <nav class="flex flex-wrap gap-4 text-sm">
      <a href="/privacy" class="hover:underline">Privacy & Cookies</a>
      <a href="/terms-of-use" class="hover:underline">Terms of use</a>
    </nav>
  </div>

  <!-- Bottom line -->
  <div class="mt-6 px-4 text-center text-xs text-gray-400">
    <p>
      &copy; <span id="footer-year">{currentYear}</span> Staptis All rights reserved
    </p>
  </div>
</footer>
<script is:inline>
  document.getElementById("footer-year").innerText = new Date().getFullYear();
</script>
