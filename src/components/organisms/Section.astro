---
import type { HTMLAttributes } from "astro/types";
import { cva } from "class-variance-authority";

interface Props extends HTMLAttributes<"section"> {
  variant?: "light" | "mediumDark" | "dark";
  first?: boolean;
}

const { variant, first } = Astro.props;

const section = cva(
  ["mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8", Astro.props.class],
  {
    variants: {
      variant: {
        light: "bg-white text-gray-900",
        mediumDark: "bg-gray-100 text-white",
        dark: "bg-gray-700 text-white",
      },
      first: {
        true: "pt-40",
      },
    },
    defaultVariants: {
      variant: "light",
    },
  },
);
---

<section class={section({ variant, first })}>
  <slot />
</section>
