---
import type { HTMLAttributes } from "astro/types";
import { cva } from "class-variance-authority";

interface Props extends HTMLAttributes<"section"> {
  variant?: "light" | "mediumDark" | "dark";
  first?: boolean;
}

const { variant, first } = Astro.props;

const section = cva(["px-20 py-10", Astro.props.class], {
  variants: {
    variant: {
      light: "bg-white text-gray-900",
      mediumDark: "bg-gray-100 text-gray-900",
      dark: "bg-gray-400 text-white",
    },
    first: {
      true: "pt-40",
    },
  },
  defaultVariants: {
    variant: "light",
  },
});
---

<section class={section({ variant, first })}>
  <slot />
</section>
