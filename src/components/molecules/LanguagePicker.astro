---
import {
  LANGUAGES,
  getLangFromPath,
  resolveRelativePath,
  addLanguagePrefix,
} from "@/utils/i18n";
import Button from "@/components/atoms/Button.astro";

const currentLang = getLangFromPath(Astro.url.pathname);
const currentPath = resolveRelativePath(Astro.url.pathname);
---

<div class="relative">
  <lang-button>
    <Button
      id="lang-toggle-btn"
      variant="simple"
      type="button"
      aria-expanded="false"
      aria-haspopup="true"
    >
      <span>{currentLang}</span>
      <svg
        class="-mr-1 ml-2 h-5 w-5"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </Button>
  </lang-button>

  <ul
    id="lang-list"
    class="hidden ring-opacity-5 absolute right-0 z-10 mt-2 w-18 rounded-md bg-white shadow-lg ring-1 ring-black focus:outline-none"
  >
    {
      LANGUAGES.filter((lang) => lang !== currentLang).map((lang) => (
          <li >
            <a
              href={addLanguagePrefix(currentPath, lang)}}
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-primary hover:text-white"
            >
              {lang}
            </a>
          </li>
        ))
    }
  </ul>
</div>

<script>
    customElements.define(
      "lang-button",
      class extends HTMLElement {
        connectedCallback() {
          const langButton = document.querySelector("#lang-toggle-btn");
          const langList = document.querySelector("#lang-list");
          langButton?.addEventListener("click", () => {
            const isOpen = langList?.classList.toggle("hidden");
            langButton.setAttribute("aria-expanded", (!isOpen).toString());
          });
        }
      },
    );

    window.addEventListener("click", (e) => {
      const langButton = document.querySelector("#lang-toggle-btn");
      const langList = document.querySelector("#lang-list");
      if (
        !langButton?.contains(e.target as Node) &&
        !langList?.contains(e.target as Node) &&
        !langList?.classList.contains("hidden")
      ) {
        langList?.classList.add("hidden");
        langButton?.setAttribute("aria-expanded", "false");
      }
    });

</script>
