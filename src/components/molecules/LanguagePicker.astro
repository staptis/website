---
import {
  LANGUAGES,
  getLangFromPath,
  resolveRelativePath,
  addLanguagePrefix,
} from "@/utils/i18n";
import Button from "@/components/atoms/Button.astro";
import globe from "@/assets/globe.svg";
import { cn } from "@/utils/cn";

const currentLang = getLangFromPath(Astro.url.pathname);
const currentPath = resolveRelativePath(Astro.url.pathname);
---

<div class="relative w-24">
  <lang-button>
    <Button
      id="lang-toggle-btn"
      variant="simple"
      type="button"
      aria-expanded="false"
      aria-haspopup="true"
    >
    <div class="flex items-center gap-2">
      <img
        src={globe.src}
        alt="Language"
        width="16"
        height="16"
      />
      <span class="uppercase">{currentLang}</span>
      <svg
        class="h-4 w-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
      </svg>
      </div>
    </Button>
  </lang-button>

  <ul
    id="lang-list"
    class="hidden ring-opacity-5 absolute right-0 z-10 mt-2 w-24 rounded-md bg-white shadow-lg ring-1 ring-black focus:outline-none"
  >
    {
      LANGUAGES.filter((lang) => lang !== currentLang).map((lang, index) => (
          <li >
            <a
              href={addLanguagePrefix(currentPath, lang)}}
              class={cn('block uppercase px-4 py-2 text-sm text-gray-700 hover:bg-primary hover:text-white',  index === 0 && 'rounded-t-md', index === LANGUAGES.length - 2 && 'rounded-b-md')}
            >
              {lang}
            </a>
          </li>
        ))
    }
  </ul>
</div>

<script>
    customElements.define(
      "lang-button",
      class extends HTMLElement {
        connectedCallback() {
          const langButton = document.querySelector("#lang-toggle-btn");
          const langList = document.querySelector("#lang-list");
          langButton?.addEventListener("click", () => {
            const isOpen = langList?.classList.toggle("hidden");
            langButton.setAttribute("aria-expanded", (!isOpen).toString());
          });
        }
      },
    );

    window.addEventListener("click", (e) => {
      const langButton = document.querySelector("#lang-toggle-btn");
      const langList = document.querySelector("#lang-list");
      if (
        !langButton?.contains(e.target as Node) &&
        !langList?.contains(e.target as Node) &&
        !langList?.classList.contains("hidden")
      ) {
        langList?.classList.add("hidden");
        langButton?.setAttribute("aria-expanded", "false");
      }
    });

</script>
