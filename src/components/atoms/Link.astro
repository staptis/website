---
import {
  resolveRelativePath,
  addLanguagePrefix,
  getLangFromPath,
} from "@/utils/i18n";
import type { HTMLAttributes } from "astro/types";
import { cva } from "class-variance-authority";

interface Props extends HTMLAttributes<"a"> {
  variant?: "simple" | "primary";
  href: string;
}

const currentPath = resolveRelativePath(Astro.url.pathname);
const { variant, href, ...props } = Astro.props;
const isActive = currentPath === href || currentPath === href + "/";
const lang = getLangFromPath(Astro.url.pathname);

const link = cva(["hover:underline", Astro.props.class], {
  variants: {
    variant: {
      simple: ["text-white"],
      primary: [
        "hover:underline-primary hover:text-primary text-gray-700 underline-offset-4",
      ],
    },
    isActive: {
      true: [""],
    },
  },
  compoundVariants: [
    {
      variant: "primary",
      isActive: true,
      class: "text-primary underline-primary underline",
    },
    {
      variant: "simple",
      isActive: true,
      class: "underline",
    },
  ],
  defaultVariants: {
    variant: "primary",
  },
});
---

<a
  {...props}
  href={addLanguagePrefix(href, lang)}
  class={link({ variant: variant, isActive })}
  aria-current={isActive ? "page" : undefined}><slot /></a
>
