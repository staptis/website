---
import type { HTMLAttributes } from "astro/types";
import { cva } from "class-variance-authority";

interface Props extends HTMLAttributes<"button"> {
  variant?: "simple" | "primary";
}

const { variant, disabled, ...props } = Astro.props;

const button = cva(
  [
    "inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-colors focus:ring-2 focus:ring-offset-2 focus:outline-none disabled:pointer-events-none disabled:opacity-50",
    Astro.props.class,
  ],
  {
    variants: {
      variant: {
        simple: [
          "bg-transparent text-gray-700 hover:bg-gray-100 focus:ring-indigo-500",
        ],
        primary: [
          "bg-indigo-600 text-white hover:bg-indigo-700 focus:ring-indigo-500",
        ],
      },
      disabled: {
        true: ["cursor-not-allowed opacity-50"],
        false: [],
      },
    },
    defaultVariants: {
      variant: "primary",
      disabled: false,
    },
  },
);
---

<button
  {...props}
  class={button({
    variant: variant,
    disabled: !!disabled,
  })}
  disabled={disabled}
>
  <slot />
</button>
