---
interface Props {
  href: string
  label: string
}

const { href, label } = Astro.props;
const currentPath = Astro.url.pathname;
---

<a href={href} class={`hover:underline underline-offset-4 hover:underline-primary p-2 hover:text-primary rounded-xl ${currentPath === href ? "underline text-primary underline-primary" : ""}`}  aria-current={currentPath === href ? "page" : undefined}>{label}</a>