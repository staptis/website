---
interface Props {
  href: string
  label: string
}

const { href, label } = Astro.props;
const currentPath = Astro.url.pathname;
---

<a href={href} class={`hover:bg-gray-200 p-2 rounded-xl ${currentPath === href ? "underline underline-offset-4" : ""}`}  aria-current={currentPath === href ? "page" : undefined}>{label}</a>